extends SceneTree

# CCH-ORIGIN-002: writes every first-winter letter, reply, answer and last word, straight from PastPostScript, to
# AI_COLLAB/CCH_ORIGIN_002_LETTERS.md, so the review reads the game's own text. Run headless:
#   godot --path . --headless -s tools/past_post_letters.gd
# Placeholders the farm fills in ({crops}, {repair}...) are shown as an example in [brackets].

const OUT := "res://AI_COLLAB/CCH_ORIGIN_002_LETTERS.md"
const EXAMPLE := {"crops": "[pumpkins]", "Crops": "[Pumpkins]", "repair": "[I've patched the holes in the farmhouse walls and boarded over the broken windows.]",
	"repair_short": "[the holes in the farmhouse walls are patched and the broken windows boarded]",
	"woods": "[There's a trail behind the house that goes up into the woods. I go up it for timber.]"}

const ROADS := [
	["A", "security_exit = stored", {"origin": "security", "security_exit": "stored", "contact": "friend"}],
	["A", "security_exit = forward", {"origin": "security", "security_exit": "forward"}],
	["A", "security_exit = extension", {"origin": "security", "security_exit": "extension"}],
	["B", "work_exit = finish", {"origin": "work", "work_exit": "finish"}],
	["B", "work_exit = instructions (opening only differs)", {"origin": "work", "work_exit": "instructions"}],
	["B", "work_exit = boundary (opening only differs)", {"origin": "work", "work_exit": "boundary"}],
	["C", "household_relation = private", {"origin": "household", "household_relation": "private"}],
	["C", "household_relation = partner, contact = former_household, contact_intent = boundaries", {"origin": "household", "household_relation": "partner", "contact": "former_household", "contact_intent": "boundaries"}],
	["D", "contact = friend, contact_intent = promise", {"origin": "curiosity", "contact": "friend", "contact_intent": "promise"}],
	["D", "contact = none", {"origin": "curiosity", "contact": "none"}],
	["E", "chance_loose_end = work_offer", {"origin": "chance", "chance_loose_end": "work_offer"}],
	["E", "chance_loose_end = storage", {"origin": "chance", "chance_loose_end": "storage"}],
	["E", "chance_loose_end = order", {"origin": "chance", "chance_loose_end": "order"}],
	["E", "chance_loose_end = meeting", {"origin": "chance", "chance_loose_end": "meeting"}],
]


func _initialize() -> void:
	var md := "# CCH-ORIGIN-002 — every first-winter letter, as the game has it\n\n"
	md += "Generated by `tools/past_post_letters.gd` from `scripts/past_post_script.gd`; do not edit by hand. "
	md += "The first letter arrives January 12 (day 104) in the farm mailbox. Replies are written in the mailbox and go with the next morning's post; the sender's answer comes 6 days later. "
	md += "Anything not answered by February 28 gets the \"no answer\" outcome on March 1. Text in [brackets] is filled from what the farm has really done.\n"
	for r in ROADS:
		var o := OriginState.new(_road(r[2]))
		var v := PastPostScript.variant(o)
		md += "\n---\n\n## %s: \"%s\"\n\n*Road: %s*\n\n" % [OriginState.ORIGIN_TITLES[o.origin()], v["title"], r[1]]
		md += "**%s.**\n\n%s\n\n" % [v["sender"], _quote(str(v["body"]))]
		for st in v["stages"]:
			var stage: Dictionary = v["stages"][st]
			if st != "first":
				md += "**Their follow-up, \"%s\"** (only after *Ask which page they mean*):\n\n%s\n\n" % [stage.get("title", ""), _quote(str(stage["body"]))]
			md += "| Answer | What the player writes | What comes back | Outcome (saved) | Diary |\n|---|---|---|---|---|\n"
			for c in stage["choices"]:
				var kind := str(c.get("kind", "reply"))
				var writes := _fill(str(c.get("reply", ""))) if kind == "reply" else ("*(diary note)* " + _fill(str(c.get("reply", ""))) if kind == "note" else "*(nothing written)* " + str(c.get("about", "")))
				var back := _fill(str(c.get("ack", ""))) if c.get("next", "") == "" else "*(the follow-up letter above)*"
				if kind != "reply":
					back = "—"
				var label := str(c["label"])
				if c.has("needs"):
					label += " *(only if: %s)*" % c["needs"]
				md += "| %s | %s | %s | `%s` · %s | %s |\n" % [label, writes, back, JSON.stringify(c.get("outcome", {})), c.get("matter", ""), _fill(str(c.get("diary", "")))]
			md += "\n"
		var lapse: Dictionary = v["lapse"]
		md += "**No answer by February 28:** %s Outcome `%s` · %s. Diary: %s\n" % [
			("\"" + str(lapse["text"]) + "\"") if str(lapse["text"]) != "" else "nothing more comes.",
			JSON.stringify(lapse["outcome"]), lapse["matter"], str(lapse.get("diary", "")) if str(lapse.get("diary", "")) != "" else "nothing."]
	var f := FileAccess.open(OUT, FileAccess.WRITE)
	f.store_string(md)
	f.close()
	print("wrote ", OUT)
	quit()


func _road(wants: Dictionary) -> Dictionary:
	var choices := {}
	var order := []
	for i in 40:
		var next := RoadScript.next_choice(choices)
		if next.is_empty():
			break
		var ids: Array = RoadScript.option_ids(next)
		var pick := str(wants.get(str(next["key"]), ids[0]))
		choices[str(next["key"])] = pick if ids.has(pick) else ids[0]
		order.append(str(next["key"]))
	return {"v": 1, "status": "complete", "choices": choices, "order": order, "day": 1}


func _fill(t: String) -> String:
	for k in EXAMPLE:
		t = t.replace("{%s}" % k, EXAMPLE[k])
	return t.replace("|", "/")


func _quote(t: String) -> String:
	return "> " + t.replace("\n\n", "\n>\n> ")
